# ==============================================================================
# ELECTROVOLT: Variables de Entorno (Plantilla de Configuración)
# Copiar como .env para sobreescribir valores por defecto del sistema
# ==============================================================================

# Entorno de ejecución: development | production | test
ELECTROVOLT_ENV=production

# Nivel de logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
ELECTROVOLT_LOG_LEVEL=INFO

# Semilla de reproducibilidad
ELECTROVOLT_SEMILLA=42

# Ruta al archivo de configuración YAML (opcional)
ELECTROVOLT_CONFIG_PATH=config.yaml

# Umbrales operativos
ELECTROVOLT_UMBRAL_CONFIANZA=0.80
ELECTROVOLT_UMBRAL_TIERRA=20.0

